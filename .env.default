
# used for local development
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
AWS_DYNAMODB_TABLE_NAME=service-portal-state-local
AWS_ENDPOINT_URL=http://localhost:5000
ROOT_PATH=/api/wps/v1/state

# moto server port and endpoint for local AWS service emulation (DynamoDB)
# MOTO_PORT is used by docker-compose to expose the container port
MOTO_PORT=5000

